# Server-side only. Never prefix any API key with VITE_.
# Copy this file to .env.local and replace only the provider you plan to use.

# Optional database path. Locally, the default is data/vibecoding-study.db.
# Railway automatically uses an attached Volume; this explicit value is recommended there.
# STUDY_DB_PATH="/data/vibecoding-study.db"

# Default provider: GPT-5.5 through Sui-Xiang.
# Every configured key joins one shared FIFO pool. Each AI development task leases
# one available key; when all keys are busy, later tasks wait automatically.
SUIXIANG_API_KEY="YOUR_SUIXIANG_API_KEY"
SUIXIANG_BASE_URL="https://sui-xiang.com"

# Optional legacy names; these keys now join the shared pool instead of being tied
# to a specific Creator.
SUIXIANG_API_KEY_APP2=""
SUIXIANG_API_KEY_APP3=""

# Optional additional pool keys. Add the same variable names in Railway Variables.
SUIXIANG_API_KEY_POOL_4=""
SUIXIANG_API_KEY_POOL_5=""

# Optional safety limits. A timed-out task is marked failed and can be retried.
AI_AGENT_STEP_TIMEOUT_MS="360000"
AI_AGENT_TOTAL_TIMEOUT_MS="1800000"

# Alternative providers. Only configure a key when that provider is selected.
DEEPSEEK_API_KEY=""
GEMINI_API_KEY=""
GLM_API_KEY=""
